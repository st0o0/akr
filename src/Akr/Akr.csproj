<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>akr</ToolCommandName>
    <PackageType>McpServer</PackageType>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64;any</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <!-- slopwatch-ignore: SW005 Newtonsoft.Json (transitive via Akka) lacks trim annotations but is unreachable at runtime — Akka.DynamicTypeLoading feature switch gates all paths, trimmer removes the code -->
    <NoWarn Condition="'$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true'">$(NoWarn);IL2104</NoWarn>

    <Authors>st0o0</Authors>
    <Copyright>Copyright (c) 2026 st0o0</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/st0o0/akr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/st0o0/akr</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Akka.NET source intelligence for AI agents. 37 MCP tools for type lookup, member signatures, config reference, stream stages, hosting extensions, docs search, version comparison, and more. Zero config - resolves latest Akka.NET source automatically.</Description>
    <PackageTags>mcp;mcp-server;akka-net;akka;dotnet;ai;source-intelligence;code-search;type-lookup</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.IO.Abstractions" />
    <PackageReference Include="Terp" />
    <PackageReference Include="Akka.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Akr.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\assets\icon-512.png" Pack="true" PackagePath="/icon.png" Visible="false" />
  </ItemGroup>

  <Target Name="GenerateVersionConst" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_VersionString>$(InformationalVersion)</_VersionString>
      <_VersionString Condition="'$(_VersionString)' == ''">$(Version)</_VersionString>
      <_VersionString>$(_VersionString.Split('+')[0])</_VersionString>
      <_VersionSourceFile>$(IntermediateOutputPath)VersionInfo.g.cs</_VersionSourceFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_VersionSourceFile)" Overwrite="true"
                      Lines="namespace Akr%3B%0A%0Apublic static class VersionInfo%0A{%0A    public const string Version = &quot;$(_VersionString)&quot;%3B%0A}" />
    <ItemGroup>
      <Compile Include="$(_VersionSourceFile)" />
    </ItemGroup>
  </Target>

</Project>
