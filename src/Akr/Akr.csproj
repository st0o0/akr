<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>

    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>

    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <PackageId>Akr</PackageId>
    <PackageTags>AI; MCP; Akka.NET; server; stdio</PackageTags>
    <Description>MCP server providing Akka.NET source intelligence for AI agents.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Terp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Akr.Tests" />
    <InternalsVisibleTo Include="Akr.Architecture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/" />
  </ItemGroup>

</Project>
